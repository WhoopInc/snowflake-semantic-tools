# Live-test configuration template. Copy it to tests/live.local.env, which git ignores,
# and fill in your own account; see docs/guides/testing-live.md for every key.
#
#   cp tests/live.example.env tests/live.local.env
#
# The process environment overrides any value here. The file is also valid shell, so
# `set -a; . tests/live.local.env; set +a` exports the same values for dbt and for the
# reference project's `verify` target.

# --- Where the tests run -------------------------------------------------------------
# The live layers create, and drop, schemas named SST_IT_<stamp>_<run>_<worker> in this
# database, and write nowhere else.
SST_TEST_SNOWFLAKE_DATABASE=MY_TEST_DATABASE
# Optional: the reference project's own schema, where the evals suite and the fixture's
# `verify` target deploy. The live layers never write to it.
SST_TEST_SNOWFLAKE_SCHEMA=MY_REFERENCE_SCHEMA

# --- Who they run as -------------------------------------------------------------------
SST_TEST_SNOWFLAKE_ACCOUNT=myorg-myaccount
SST_TEST_SNOWFLAKE_USER=sst_test_user
SST_TEST_SNOWFLAKE_ROLE=SST_TEST_ROLE
SST_TEST_SNOWFLAKE_WAREHOUSE=SST_TEST_WH

# --- How they sign in: pick one ----------------------------------------------------------
# A key pair: the path to an unencrypted PKCS#8 private key.
SST_TEST_SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/sst_test.p8
# Or an authenticator, such as externalbrowser (SSO).
# SST_TEST_SNOWFLAKE_AUTHENTICATOR=externalbrowser
# Or a connection in ~/.snowflake/connections.toml or config.toml; it supplies any of
# the values above left unset, and its other driver settings.
# SST_TEST_SNOWFLAKE_CONNECTION=my-connection

# --- Optional ------------------------------------------------------------------------------
# A role the test role may grant SELECT to; enables the grant-preservation check.
# SST_TEST_SNOWFLAKE_GRANTEE_ROLE=SST_TEST_READER
